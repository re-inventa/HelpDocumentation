FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
WORKDIR /docs
COPY reauditia/requirements-docs.txt /tmp/requirements-docs.txt
RUN pip install --no-cache-dir -r /tmp/requirements-docs.txt
COPY reauditia ./reauditia
COPY reagentia ./reagentia
COPY README.md ./README.md
COPY .github ./.github
RUN python reauditia/scripts/validate_navigation.py && \
    python reauditia/scripts/validate_content.py --source && \
    python -m mkdocs build --strict -f reauditia/mkdocs.yml && \
    python reauditia/scripts/validate_content.py --site && \
    python reauditia/scripts/validate_links.py && \
    python reauditia/scripts/validate_routes.py && \
    python -m unittest discover -s reauditia/scripts/tests -v
